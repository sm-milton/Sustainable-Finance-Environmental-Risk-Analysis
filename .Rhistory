"Extreme wind", "Storms and wind", "Storm", "Storms and wind",
"Hurricanes, cyclones, typhoons", "Storms and wind",
"Fire weather (wildfire risk)", "Wildfire",
"Extreme cold", "Cold and snow", "Snow and ice", "Cold and snow",
"Infectious disease", "Infectious disease",
"Mass movement", "Land and ecosystem change", "Soil degradation/erosion", "Land and ecosystem change",
"Biodiversity loss", "Land and ecosystem change", "Loss of green space/green cover", "Land and ecosystem change"
)
fam_rank <- haz_city %>% inner_join(family_map, by = "hazard") %>%
distinct(cityid, family) %>% count(family, name = "cities", sort = TRUE) %>%
mutate(pct_of_reporting_cities = round(100 * cities / n_cities_hazard, 1))
kable(fam_rank, caption = "Hazard families (each city counted once per family)")
# Chunk 10: haz-region
region_n <- city_haz_text %>% count(cityregion, name = "n_region")
reg_fam <- haz_city %>% inner_join(family_map, by = "hazard") %>%
distinct(cityid, cityregion, family) %>%
count(cityregion, family, name = "cities") %>%
left_join(region_n, by = "cityregion") %>%
mutate(pct = 100 * cities / n_region)
top_fams <- fam_rank$family[1:6]
reg_fam %>% filter(family %in% top_fams) %>%
mutate(family = factor(family, levels = top_fams),
region_lab = paste0(cityregion, " (n=", n_region, ")")) %>%
ggplot(aes(family, region_lab, fill = pct)) +
geom_tile(colour = "white") +
geom_text(aes(label = round(pct)), size = 3) +
scale_fill_gradient(low = "white", high = "#2c7fb8", name = "% of cities") +
labs(title = "Share of cities reporting each hazard family, by region", x = NULL, y = NULL) +
theme_minimal() + theme(axis.text.x = element_text(angle = 30, hjust = 1))
# Chunk 11: vulnerable
terms <- c("elderly|older people|older adults|seniors" = "Elderly people",
"children|child|infants" = "Children",
"low-income|low income|poor|poverty|LMI" = "Low-income households",
"homeless|informal settlement|slum" = "Homeless / informal settlements",
"disabilit" = "People with disabilities",
"agricultur|farm|crop|food" = "Agriculture and food",
"water supply|drinking water|water scarcity" = "Water supply",
"health|hospital|disease" = "Health",
"transport|road|infrastructure" = "Transport and infrastructure",
"energy|electricity|power" = "Energy")
term_counts <- map_dfr(names(terms), function(p) {
tibble(group = terms[[p]],
cities = n_distinct(city_haz_text$cityid[str_detect(str_to_lower(city_haz_text$climate_hazard), str_to_lower(p))]))
}) %>% mutate(pct_of_reporting_cities = round(100 * cities / n_cities_hazard, 1)) %>% arrange(desc(cities))
kable(term_counts, caption = "Cities mentioning vulnerable groups or sectors (keyword search; indicative only)")
# Chunk 12: haz-inline-values
top5 <- haz_rank %>% slice_head(n = 5)
heat_pct  <- fam_rank$pct_of_reporting_cities[fam_rank$family == "Heat"]
flood_pct <- fam_rank$pct_of_reporting_cities[fam_rank$family == "Flooding and heavy rain"]
dry_pct   <- fam_rank$pct_of_reporting_cities[fam_rank$family == "Drought and water scarcity"]
# Chunk 13: region
proj <- projects %>% filter(has_project)
region_summary <- proj %>%
group_by(Region = cityregion) %>%
summarise(
`Planned projects` = n(),
`Valid costs` = sum(inv_cost_flag == "valid"),
`Cost missing or zero` = sum(inv_cost_flag %in% c("missing", "zero")),
`Implausible costs removed` = sum(inv_cost_flag == "implausible (> US$1 trillion)"),
`Funding sought, cleaned (USD)` = sum(project_investmentcost[inv_cost_flag == "valid"]),
.groups = "drop") %>%
arrange(desc(`Funding sought, cleaned (USD)`))
# The same table with the raw sum (implausible entries included), to show
# what the difference is made of. The raw sums are not comparable across regions.
region_raw <- proj %>%
group_by(Region = cityregion) %>%
summarise(`Funding sought, raw sum (USD)` = sum(project_investmentcost, na.rm = TRUE), .groups = "drop")
list(cleaned = region_summary, raw = region_raw) %>% kable(caption = "Planned projects and funding sought by region")
# Chunk 14: region-plot
region_summary %>%
mutate(Region = fct_reorder(Region, `Funding sought, cleaned (USD)`)) %>%
ggplot(aes(`Funding sought, cleaned (USD)` / 1e9, Region)) +
geom_col(fill = "#2c7fb8") +
geom_text(aes(label = paste0("US$", round(`Funding sought, cleaned (USD)` / 1e9, 1), "bn (", `Planned projects`, " projects)")),
hjust = -0.05, size = 3.2) +
scale_x_continuous(expand = expansion(mult = c(0, 0.45))) +
labs(title = "Funding sought by region (cleaned)", x = "US$ billions", y = NULL) +
theme_minimal()
# Chunk 15: region-totals
tibble(`Total planned projects` = nrow(proj),
`Total funding sought, cleaned (USD)` = sum(proj$project_investmentcost[proj$inv_cost_flag == "valid"]),
`Total funding sought, raw sum (USD)` = sum(proj$project_investmentcost, na.rm = TRUE)) %>%
kable(format.args = list(big.mark = ","), caption = "All regions combined")
# Chunk 16: region-values
top_reg <- region_summary$Region[1]
top_reg_amt <- region_summary$`Funding sought, cleaned (USD)`[1] / 1e9
most_proj <- region_summary$Region[which.max(region_summary$`Planned projects`)]
n_all <- sum(region_summary$`Planned projects`)
pct_cost <- round(100 * sum(region_summary$`Valid costs`) / n_all, 1)
# Chunk 17: shortlist
ppp_regex  <- regex("public-private partnership|public.private|p[uú]blico.privad|\\bPPP\\b|\\bAPP\\b|ESCO", ignore_case = TRUE)
loan_regex <- regex("Loans from International Financial Institutions|Loans from commercial banks", ignore_case = TRUE)
waste <- proj %>%
mutate(sector = str_extract(project_info, "^[^:\\-]+?(?=\\s+-\\s|:)"),
is_waste = str_detect(project_info, "^Waste management \\(including waste recycling\\)"),
fund_loan = str_detect(project_fundingmodel, loan_regex),
fund_ppp  = str_detect(project_fundingmodel, ppp_regex),
fund_ok   = coalesce(fund_loan | fund_ppp, FALSE),
project_title = project_info %>%
str_remove("^Waste management \\(including waste recycling\\)\\s*-\\s*") %>%
str_extract("^[^:]+") %>% str_trunc(70))
funnel <- tibble(
Step = c("Planned projects", "Waste management sector", "... and city has business collaboration",
"... and loan or PPP financing", "... and valid positive investment cost (shortlist)"),
Projects = c(nrow(proj),
sum(waste$is_waste),
sum(waste$is_waste & waste$collab_business %in% 1),
sum(waste$is_waste & waste$collab_business %in% 1 & waste$fund_ok),
sum(waste$is_waste & waste$collab_business %in% 1 & waste$fund_ok & waste$inv_cost_flag == "valid")))
kable(funnel, caption = "Screening funnel")
# Chunk 18: shortlist-table
shortlist <- waste %>%
filter(is_waste, collab_business %in% 1, fund_ok, inv_cost_flag == "valid") %>%
arrange(desc(project_investmentcost)) %>%
transmute(Rank = row_number(), City = cityname, Country = cityarea, Region = cityregion,
Project = project_title,
`Financing model` = str_replace_all(project_fundingmodel, "\\|", "; "),
`Investment sought (USD)` = project_investmentcost,
`Total cost (USD)` = project_totalcost,
`Cost plausibility` = if_else(project_investmentcost / project_totalcost > 50,
"Investment far exceeds total cost (likely unit/currency error)",
"Consistent"))
kable(shortlist, format.args = list(big.mark = ","), caption = "Ranked collaboration and investment opportunities")
# Chunk 19: shortlist-values
n_short <- nrow(shortlist)
n_region_short <- shortlist %>% count(Region, sort = TRUE)
# Chunk 20: shortlist-nocost
waste %>%
filter(is_waste, collab_business %in% 1, fund_ok, inv_cost_flag != "valid") %>%
transmute(City = cityname, Region = cityregion, Project = project_title,
`Financing model` = str_replace_all(project_fundingmodel, "\\|", "; "),
`Investment cost status` = inv_cost_flag) %>%
kable(caption = "Matching projects without a rankable investment cost")
# Chunk 21: eda
firms_m <- firms %>% mutate(env_contro = factor(env_contro, levels = c(1, 0), labels = c("Yes", "No")))
firms_m %>% count(env_contro) %>% mutate(share = percent(n / sum(n), 0.1)) %>%
kable(caption = "Outcome balance: controversies are rare")
set.seed(2026)
data_split <- initial_split(firms_m, prop = 0.8, strata = env_contro, pool = 0)
set.seed(2026)
# Stratified 80/20 split in base R: sample 80% within each outcome group
idx_yes <- which(firms_m$env_contro == "Yes")
idx_no  <- which(firms_m$env_contro == "No")
train_idx <- sort(c(sample(idx_yes, round(0.8 * length(idx_yes))),
sample(idx_no,  round(0.8 * length(idx_no)))))
train <- firms_m[train_idx, ]
test  <- firms_m[-train_idx, ]
tibble(set = c("Training", "Test"), firms = c(nrow(train), nrow(test)),
controversies = c(sum(train$env_contro == "Yes"), sum(test$env_contro == "Yes")),
rate = percent(c(mean(train$env_contro == "Yes"), mean(test$env_contro == "Yes")), 0.1)) %>%
kable(caption = "Stratified 80/20 split; the test set is not touched until the final evaluation")
# Chunk 1: setup
knitr::opts_chunk$set(echo = TRUE, message = FALSE, warning = FALSE,
fig.width = 9, fig.height = 5.5, out.width = "100%")
options(scipen = 999, dplyr.summarise.inform = FALSE)
# Chunk 2
# Install any missing packages, then load them
if(!require("pacman"))install.packages("pacman")
pacman::p_load(readr, dplyr, tidyr, stringr, lubridate, purrr, ggplot2, gridExtra, GGally, corrplot)
pacman::p_load(tidytext, textstem, wordcloud, textdata, topicmodels)
pacman::p_load(DescTools, skimr, finalfit, rstatix, huxtable, jtools)
pacman::p_load(knitr, easystats, gtsummary, gt, scales)
pacman::p_load(SnowballC, textstem)
pacman::p_load(caret, tibble, forcats, tidyverse, rsample, tidymodels, cli, purrr)
# Chunk 3: load
projects_raw <- read_csv("env_projects.csv", show_col_types = FALSE)
firms        <- read_csv("env_controversy.csv", show_col_types = FALSE)
tibble(
dataset = c("env_projects", "env_controversy"),
rows    = c(nrow(projects_raw), nrow(firms)),
columns = c(ncol(projects_raw), ncol(firms)),
distinct_ids = c(n_distinct(projects_raw$cityid), n_distinct(firms$firm_id))
) %>% kable(caption = "Dataset dimensions")
# Chunk 4: audit
n_exact_dups   <- sum(duplicated(projects_raw))
n_no_project   <- sum(is.na(projects_raw$project_info))
n_missing_inv  <- sum(is.na(projects_raw$project_investmentcost))
n_zero_inv     <- sum(projects_raw$project_investmentcost == 0, na.rm = TRUE)
# Costs above US$1 trillion are treated as implausible data-entry errors
# (the largest city-level project is far below this; the maximum value is 3.7e15)
IMPLAUSIBLE <- 1e12
n_implausible <- sum(projects_raw$project_investmentcost > IMPLAUSIBLE, na.rm = TRUE)
# Investment cost far above the total project cost (roughly 1000x) suggests
# a currency/unit conversion error in the source data.
ratio <- projects_raw$project_investmentcost / projects_raw$project_totalcost
n_unit_errors <- sum(ratio > 50, na.rm = TRUE)
projects <- projects_raw %>%
distinct() %>%                       # remove exact duplicate rows
mutate(has_project = !is.na(project_info),
inv_cost_flag = case_when(
is.na(project_investmentcost)          ~ "missing",
project_investmentcost > IMPLAUSIBLE   ~ "implausible (> US$1 trillion)",
project_investmentcost == 0            ~ "zero",
TRUE                                   ~ "valid"))
# Chunk 5: audit-table
projects %>% filter(has_project) %>% count(inv_cost_flag, name = "project_rows") %>%
kable(caption = "Quality of `project_investmentcost` across project rows")
# Chunk 6: haz-prep
city_haz <- projects %>%
distinct(cityid, cityname, cityregion, climate_hazard)
n_cities_total    <- n_distinct(city_haz$cityid)
city_haz_text     <- city_haz %>% filter(!is.na(climate_hazard))
n_cities_hazard   <- n_distinct(city_haz_text$cityid)
haz_entries <- city_haz_text %>%
separate_rows(climate_hazard, sep = " \\| ") %>%
mutate(entry = str_squish(climate_hazard),
label_raw = str_squish(str_extract(entry, "^[^:]+")))
# Malformed labels: kept for transparency, excluded from counts
malformed <- haz_entries %>% filter(is.na(label_raw) | label_raw == "" | nchar(label_raw) > 60)
haz_clean <- haz_entries %>%
filter(!(is.na(label_raw) | label_raw == "" | nchar(label_raw) > 60)) %>%
mutate(hazard = str_to_sentence(label_raw),
hazard = recode(hazard,
"Infectious diseases" = "Infectious disease",
"Fire weather (risk of wildfires)" = "Fire weather (wildfire risk)",
"Coastal flooding (incl. sea level rise)" = "Coastal flooding (incl. sea level rise)",
"Hurricanes, cyclones, and/or typhoons" = "Hurricanes, cyclones, typhoons"))
haz_city <- haz_clean %>% distinct(cityid, cityregion, hazard)
haz_rank <- haz_city %>%
count(hazard, name = "cities", sort = TRUE) %>%
mutate(pct_of_reporting_cities = round(100 * cities / n_cities_hazard, 1))
# Chunk 7: haz-table
haz_rank %>% kable(caption = "Climate hazards ranked by number of cities reporting them")
# Chunk 8: haz-plot
haz_rank %>%
mutate(hazard = fct_reorder(hazard, cities)) %>%
ggplot(aes(cities, hazard)) +
geom_col(fill = "#2c7fb8") +
geom_text(aes(label = paste0(cities, " (", pct_of_reporting_cities, "%)")), hjust = -0.05, size = 3) +
scale_x_continuous(expand = expansion(mult = c(0, 0.2))) +
labs(title = "Climate hazards reported by cities",
subtitle = paste0("Share of the ", n_cities_hazard, " cities with hazard text; each city counted once per hazard"),
x = "Number of cities", y = NULL) +
theme_minimal()
