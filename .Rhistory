slog <- function(x) sign(x) * log1p(abs(x))
sdiv <- function(a, b) ifelse(!is.na(b) & b > 0, a / b, NA_real_)
log_vars <- c("env_co2s1", "env_co2s2", "env_co2s3", "env_energy",
"fin_asset", "fin_rev", "fin_cor", "fin_capex", "marketcap")
rec <- recipe(env_contro ~ ., data = train) %>%
update_role(firm_id, firm_name, new_role = "id") %>%
step_mutate(capex_assets = sdiv(fin_capex, fin_asset),
cor_rev      = sdiv(fin_cor, fin_rev),
co2_int      = sdiv(env_co2s1 + env_co2s2, fin_rev),
energy_int   = sdiv(env_energy, fin_rev),
rev_assets   = sdiv(fin_rev, fin_asset),
mcap_assets  = sdiv(marketcap, fin_asset)) %>%
step_mutate_at(all_of(log_vars), fn = slog) %>%
step_mutate_at(c("co2_int", "energy_int"), fn = slog) %>%
step_other(industry, threshold = 0.01) %>%
step_other(firm_hq, threshold = 0.02) %>%
step_indicate_na(env_co2s1, env_co2s2, env_co2s3, env_energy, fin_cor, fin_cr) %>%
step_impute_median(all_numeric_predictors()) %>%
step_zv(all_predictors()) %>%
step_dummy(all_nominal_predictors()) %>%
step_normalize(all_numeric_predictors())
